{
  "name": "@deepseek-ai/dsh-douyin-local",
  "version": "0.2.3-alpha.2",
  "type": "module",
  "description": "Vertical 1080x1920 Douyin explainer tools over the local vibe-knowledge + cine pipeline.",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "python/**"
  ]
}
